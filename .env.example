RANDOM_STATE=42
TEST_SIZE=0.25
TARGETCOL=hg/ha_yield

PROJECT_ROOT=.
DATASET_DIR=dataset
YIELD_DATASET=yield_df.csv
CROP_DATASET=Crop_recommendation.csv

MODEL_DIR=models
YIELD_MODEL_NAME=model.joblib
CROP_MODEL_NAME=crop_recommendation_model.pkl

# Auth
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRE_HOURS=72
DEV_MODE=false

# Railway: mount a volume at /data for persistent SQLite
DATABASE_PATH=/data/cropeazy.db

# Render: persistent disk mounted at /var/data (see render.yaml)
# DATABASE_PATH=/var/data/cropeazy.db

# Location / weather (recommended on Render — avoids free API rate limits)
# Free key: https://openweathermap.org/api → sign up → API keys
OPENWEATHER_API_KEY=

# SMS (optional — set DEV_MODE=true to log OTPs instead)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
